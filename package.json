{
  "name": "breadboard-8bit",
  "private": true,
  "version": "0.1.0",
  "description": "Browser simulator that follows Ben Eater's 'Building an 8-bit breadboard computer!' playlist",
  "keywords": [
    "555-timer",
    "74ls",
    "8-bit-computer",
    "ben-eater",
    "breadboard",
    "circuit-simulator",
    "digital-logic",
    "education",
    "electronics",
    "homebrew-computer",
    "interactive-learning",
    "logic-simulator",
    "pwa",
    "sap-1",
    "threejs",
    "ttl",
    "typescript",
    "webxr"
  ],
  "homepage": "https://ariamokr.github.io/breadboard/",
  "bugs": {
    "url": "https://github.com/AriaMoKr/breadboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/breadboard.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode vr && node scripts/sw-dist.mjs && node scripts/zip-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "preview-image": "node scripts/make-preview.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:input": "node scripts/check-input.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "iwer": "^2.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "common": "github:AriaMoKr/common#v0.1.0",
    "layersharedsession": "github:AriaMoKr/layersharedsession#v0.2.0",
    "three": "^0.186.1",
    "trystero": "^0.26.0"
  }
}
