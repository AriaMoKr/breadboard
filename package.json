{
  "name": "breadboard-8bit",
  "private": true,
  "version": "0.1.0",
  "description": "Browser simulator that follows Ben Eater's 'Building an 8-bit breadboard computer!' playlist",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode vr && node scripts/sw-dist.mjs && node scripts/zip-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:input": "node scripts/check-input.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
